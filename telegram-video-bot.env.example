# Create a bot with @BotFather. No quotes are necessary for a simple token.
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Numeric group IDs commonly begin with -100; private chat ID = your user ID.
# You can leave this blank temporarily and use /id to discover the IDs.
ALLOWED_CHAT_IDS=
# Added to the included Youtube/Instagram/TikTok/X/Reddit/etc allowlist.
# Example: EXTRA_DOMAINS=example.com,another.net
EXTRA_DOMAINS=
MAX_UPLOAD_BYTES=47000000
DOWNLOAD_TIMEOUT_SECONDS=240
MAX_PENDING=3
WORK_DIR=/var/lib/telegram-video-bot/jobs
